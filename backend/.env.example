# Application
APP_NAME=EV Test Platform
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/evtest

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# GitLab (optional)
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=

# ALM (optional)
ALM_URL=https://alm.example.com
ALM_USERNAME=
ALM_PASSWORD=

# Artifact Repository (optional)
ARTIFACT_REPO_URL=https://nexus.example.com
ARTIFACT_REPO_USERNAME=
ARTIFACT_REPO_PASSWORD=

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com

# Encryption
ENCRYPTION_KEY=your-encryption-key-32-bytes-long

# Logging
LOG_LEVEL=INFO
